using System;

class Student
{
    public int roll_no;
    public string name;
}

class Test : Student
{
    public int marks1, marks2;
}

class Result : Test
{
    int total;

    public void Accept()
    {
        Console.Write("Enter Roll No: ");
        roll_no = Convert.ToInt32(Console.ReadLine());

        Console.Write("Enter Name: ");
        name = Console.ReadLine();

        Console.Write("Enter Marks1: ");
        marks1 = Convert.ToInt32(Console.ReadLine());

        Console.Write("Enter Marks2: ");
        marks2 = Convert.ToInt32(Console.ReadLine());
    }

    public void Display()
    {
        total = marks1 + marks2;

        Console.WriteLine("\nRoll No: " + roll_no);
        Console.WriteLine("Name: " + name);
        Console.WriteLine("Marks1: " + marks1);
        Console.WriteLine("Marks2: " + marks2);
        Console.WriteLine("Total: " + total);
    }
}

class Program
{
    static void Main()
    {
        Result r = new Result();

        r.Accept();
        r.Display();
    }
}
