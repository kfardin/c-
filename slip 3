using System;

class Program
{
    static void Main()
    {
        int[] a = {5,2,4,1,3};

        Array.Sort(a);

        Console.WriteLine("Ascending Order:");
        foreach(int i in a)
            Console.Write(i + " ");

        Array.Reverse(a);

        Console.WriteLine("\nDescending Order:");
        foreach(int i in a)
            Console.Write(i + " ");
    }
}

